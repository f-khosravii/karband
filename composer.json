{
    "name": "karband/platform",
    "description": "Clean modular platform monorepo",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "karband/audit": "@dev",
        "karband/authorization": "@dev",
        "karband/billing": "@dev",
        "karband/directory": "@dev",
        "karband/directory-laravel": "@dev",
        "karband/documents": "@dev",
        "karband/dynamic-forms": "@dev",
        "karband/external-auth": "@dev",
        "karband/request-journey": "@dev",
        "karband/service-catalog": "@dev",
        "karband/service-recipients": "@dev",
        "karband/service-requests": "@dev",
        "karband/workflow": "@dev"
    },
    "autoload-dev": {
        "psr-4": {
            "Karband\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^12"
    },
    "scripts": {
        "test": "phpunit",
        "architecture": "phpunit --filter Architecture",
        "qa": "phpunit"
    }
}
