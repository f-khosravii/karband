{
    "name": "intl/platform",
    "description": "INTL shared architecture and reusable packages",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "intl/billing": "dev-main",
        "intl/contracts": "@dev",
        "intl/directory": "dev-main",
        "intl/directory-laravel": "dev-main",
        "intl/documents": "dev-main",
        "intl/dynamic-forms": "dev-main",
        "intl/external-auth": "dev-main",
        "intl/request-journey": "dev-main",
        "intl/service-catalog": "dev-main",
        "intl/service-recipients": "dev-main",
        "intl/service-requests": "dev-main",
        "intl/workflow": "@dev"
    },
    "autoload": {},
    "autoload-dev": {},
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^12"
    }
}
