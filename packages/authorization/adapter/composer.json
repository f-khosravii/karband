{
    "name": "karband/authorization-laravel",
    "description": "Fail-closed Laravel/Spatie authorization adapter for INTL services",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "illuminate/auth": "^13.0",
        "illuminate/support": "^13.0",
        "spatie/laravel-permission": "^8.0",
        "karband/authorization": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Karband\\AuthorizationLaravel\\": "src/"
        }
    },
    "suggest": {
        "karband/workflow-laravel": "Optional WorkflowAuthorizer and ActorResolver bridge"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Karband\\AuthorizationLaravel\\AuthorizationLaravelServiceProvider"
            ]
        }
    }
}
