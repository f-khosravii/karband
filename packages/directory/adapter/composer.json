{
    "name": "karband/directory-laravel",
    "description": "Fail-closed local Laravel persistence and resolution for INTL Directory",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "karband/directory": "@dev",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Karband\\DirectoryLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Karband\\DirectoryLaravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Karband\\DirectoryLaravel\\DirectoryLaravelServiceProvider"
            ]
        }
    }
}
