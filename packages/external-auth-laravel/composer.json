{
  "name": "intl/external-auth-laravel",
  "description": "Laravel bridge for INTL External Authentication boundary",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "intl/contracts": "dev-main",
    "intl/authorization-laravel": "dev-main",
    "intl/external-auth": "dev-main",
    "illuminate/auth": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/support": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Intl\\ExternalAuthLaravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Intl\\ExternalAuthLaravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Intl\\ExternalAuthLaravel\\ExternalAuthLaravelServiceProvider"
      ]
    }
  }
}
