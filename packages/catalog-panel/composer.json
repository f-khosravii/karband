{
    "name": "karband/catalog-panel",
    "description": "Role-agnostic Service Catalog management panel for Karband",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/view": "^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Karband\\CatalogPanel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Karband\\CatalogPanel\\CatalogPanelServiceProvider"
            ]
        }
    }
}
