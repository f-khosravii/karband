{
  "name": "intl/billing-laravel",
  "description": "Independent local payment records and central payment gateway port for INTL Laravel services",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "intl/billing": "dev-main",
    "intl/contracts": "dev-main",
    "intl/authorization-laravel": "dev-main",
    "illuminate/support": "^13.0",
    "illuminate/database": "^13.0",
    "intl/service-catalog-laravel": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "Intl\\BillingLaravel\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Intl\\BillingLaravel\\BillingLaravelServiceProvider"
      ]
    }
  }
}
