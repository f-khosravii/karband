{
  "name": "intl/directory-laravel",
  "description": "Fail-closed local Laravel persistence and resolution for INTL Directory",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "intl/directory": "dev-main",
    "intl/contracts": "@dev",
    "illuminate/database": "^13.0",
    "illuminate/support": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Intl\\DirectoryLaravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Intl\\DirectoryLaravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Intl\\DirectoryLaravel\\DirectoryLaravelServiceProvider"
      ]
    }
  }
}
