{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "karband/sandbox",
    "type": "project",
    "description": "Integration sandbox application for platform packages.",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "karband/audit": "@dev",
        "karband/audit-laravel": "@dev",
        "karband/auth-panel": "@dev",
        "karband/authentication": "@dev",
        "karband/authentication-laravel": "@dev",
        "karband/authorization": "@dev",
        "karband/authorization-laravel": "@dev",
        "karband/billing": "@dev",
        "karband/billing-laravel": "@dev",
        "karband/catalog-panel": "@dev",
        "karband/directory": "@dev",
        "karband/directory-laravel": "@dev",
        "karband/directory-panel": "@dev",
        "karband/documents": "@dev",
        "karband/documents-laravel": "@dev",
        "karband/dynamic-forms": "@dev",
        "karband/dynamic-forms-laravel": "@dev",
        "karband/external-auth": "@dev",
        "karband/external-auth-laravel": "@dev",
        "karband/request-journey": "@dev",
        "karband/request-journey-laravel": "@dev",
        "karband/service-catalog": "@dev",
        "karband/service-catalog-laravel": "@dev",
        "karband/service-recipients": "@dev",
        "karband/service-recipients-laravel": "@dev",
        "karband/service-requests": "@dev",
        "karband/service-requests-laravel": "@dev",
        "karband/workflow": "@dev",
        "karband/workflow-laravel": "@dev",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Karband\\ExternalAuthLaravel\\Testing\\": "../../packages/external-auth/adapter/tests/Testing/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "name": "platform-local",
            "type": "path",
            "url": "../../packages/*/*"
        },
        {
            "name": "platform-local-root",
            "type": "path",
            "url": "../../packages/*"
        }
    ]
}
